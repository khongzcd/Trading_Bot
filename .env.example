API_KEY=your_api_key
API_SECRET=your_api_secret
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# false = จำลอง (ปลอดภัย), true = เทรดจริง
LIVE_TRADING=false

# Scanner
QUOTE=THB
TIMEFRAME=15m
MIN_QUOTE_VOLUME=500000
MAX_COINS_PER_SCAN=40
REQUEST_DELAY=1.0
SCAN_INTERVAL=120
TOP_ALERTS=5

# Risk
MAX_ORDER_QUOTE=100
MAX_POSITIONS=3
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4
MAX_DAILY_LOSS_QUOTE=500
